# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Use a long random string.
CRON_SECRET=

# Where one month ends and the next begins (IANA zone). Default UTC.
RECAP_TIME_ZONE=UTC

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECAP_REPORT_BUCKET=recap-reports

# Gmail SMTP: needs 2-Step Verification + an App Password (not your account password).
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional. Gmail only allows the authenticated address or a verified alias.
SMTP_FROM=

# Local development without any external service: seeded data, mail printed to the console.
# RECAP_ADAPTERS=memory

# The existing "opted-in users + ledgers" API (one call, returns every user with their opted-in ledgers).
FINTRACK_USERS_API_URL=
# Optional: sent as "Authorization: Bearer <token>".
FINTRACK_API_TOKEN=
