{
	"compilerOptions": {
        "rootDir": "./src",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"declaration": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
        "outDir": "./dist"
	},
	"include": ["src/**/*"]
}

