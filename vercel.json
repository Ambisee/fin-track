{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "nextjs",
			"buildCommand": "pnpm run -w build:web"
		},
		"recap": {
			"root": "apps/recap",
			"framework": "nitro",
			"buildCommand": "pnpm run -w build:recap",
			"functions": {
				"src/**/*.js": {
					"includeFiles": "node_modules/.pnpm/pdfkit@*/node_modules/pdfkit/js/standard-fonts/**"
				}
			}
		}
	},
	"rewrites": [
		{
			"source": "/api/cron/month-end-recap",
			"destination": {
				"service": "recap"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "web"
			}
		}
	],
	"schedules": {
		"month-end-recap": {
			"schedule": "0 1 1 * *",
			"requestMethod": "GET",
			"path": "/api/cron/month-end-recap"
		}
	}
}
