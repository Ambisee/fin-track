{
	"name": "fin-track",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.28.8",
	"scripts": {
		"dev": "pnpm --filter \"./apps/*\" --parallel dev",
		"dev:transaction-report": "pnpm --filter @fintrack/transaction-report dev",
		"dev:web": "pnpm --parallel --filter @fintrack/web --filter @fintrack/transaction-report dev",
		"dev:recap": "pnpm --parallel --filter @fintrack/recap --filter @fintrack/transaction-report dev",
		"build": "pnpm -r build",
		"build:transaction-report": "pnpm --filter @fintrack/transaction-report build",
		"build:web": "pnpm run build:transaction-report && pnpm --filter @fintrack/web build",
		"build:recap": "pnpm run build:transaction-report && pnpm --filter @fintrack/recap build",
		"lint": "pnpm -r lint",
		"test": "pnpm -r test"
	}
}
