{
	"name": "fin-track-monorepo",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.28.8",
	"scripts": {
		"dev": "pnpm --filter \"./apps/*\" --parallel dev",
		"dev:web": "pnpm --filter @fintrack/web dev",
		"dev:api": "pnpm --filter @fintrack/api dev",
		"build": "pnpm -r build",
		"build:web": "pnpm --filter @fintrack/web build",
		"build:api": "pnpm --filter @fintrack/api build",
		"lint": "pnpm -r lint",
		"test": "pnpm -r test"
	}
}
